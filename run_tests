#!/usr/bin/env python3
"""One-command test runner for the enhancement exercise.

Usage: ./run_tests

This script performs:
- Baseline integrity verification (SHA256 of immutable files)
- Semantic equivalence checks (>=200 deterministic queries)
- Payload disk-read verification (seek+read per returned event)
- Concurrency correctness checks (>=32 threads)
- Performance benchmarking (median-of-3 runs, concurrency=32)
- Quantified performance gates (p99 and RPS improvements)

Exit code: 0 on success, non-zero on any failure.
"""
from __future__ import annotations

import builtins
import hashlib
import json
import math
import os
import random
import sqlite3
import statistics
import sys
import threading
import time
from contextlib import contextmanager
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Any, Dict, List, Tuple

import audit_log_service as baseline
import enhanced_service as enhanced
import runner

BASELINE_HASHES = {
    "audit_log_service.py": "1aa1b83de1d6c4f87f7c1cdf641762c23417dfad5d67baa9d91d9dedaa8351e7",
    "runner.py": "9bd8e432e73c2a02a123a8e90d937bb11e448b7eaaf4c4efb95e469f6c85b6f9",
}

# Benchmark parameters
WARMUP = 64
TOTAL = 512
CONCURRENCY = 32
BENCH_RUNS = 3

MAX_PAGE = 2000
PAGE_SIZES = [10, 20, 50]



def sha256(path: str) -> str:
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def check_baseline_integrity() -> None:
    for fname, expected in BASELINE_HASHES.items():
        got = sha256(fname)
        if got != expected:
            print(f"ERROR: baseline file {fname} has unexpected hash:\n  expected {expected}\n  got      {got}")
            sys.exit(2)
    print("✅ Baseline file integrity verified")


# A tiny wrapper to reproduce baseline SQL + payload-reading semantics per-query
def baseline_query(q: baseline.Query) -> Dict[str, Any]:
    offset_rows = (q.page - 1) * q.page_size
    conn = sqlite3.connect(baseline.DB_PATH, check_same_thread=False)
    cur = conn.cursor()
    cur.execute(
        """
        SELECT id, created_at, actor_id, action, resource_type, resource_id,
               payload_offset, payload_len
        FROM audit_events
        WHERE created_at BETWEEN ? AND ?
          AND (? IS NULL OR actor_id = ?)
          AND (? IS NULL OR action = ?)
        ORDER BY created_at DESC, id DESC
        LIMIT ? OFFSET ?
        """,
        (
            q.from_ts,
            q.to_ts,
            q.actor_id,
            q.actor_id,
            q.action,
            q.action,
            q.page_size,
            offset_rows,
        ),
    )
    rows = cur.fetchall()
    conn.close()

    events = []
    # Baseline's _read_payload opens the payload file per event; reproduce that
    for (eid, created_at, actor_id, action, rtype, rid, poff, plen) in rows:
        with open(baseline.PAYLOAD_FILE, "rb") as f:
            f.seek(poff)
            payload = json.loads(f.read(plen))
        events.append(
            {
                "id": eid,
                "created_at": created_at,
                "actor_id": actor_id,
                "action": action,
                "resource_type": rtype,
                "resource_id": rid,
                "payload": payload,
            }
        )

    return {"query": q.__dict__, "events": events, "count": len(events)}


@contextmanager
def instrument_payload_access(counter: Dict[str, int]):
    """Temporarily patch builtins.open to wrap payload file handles and count seek/read calls.

    The wrapper only intercepts opens whose filename ends with the payload filename.
    """
    real_open = builtins.open

    class FileWrapper:
        def __init__(self, f):
            self._f = f

        def seek(self, *a, **kw):
            counter.setdefault("seek_calls", 0)
            counter["seek_calls"] += 1
            return self._f.seek(*a, **kw)

        def read(self, *a, **kw):
            counter.setdefault("read_calls", 0)
            counter["read_calls"] += 1
            return self._f.read(*a, **kw)

        def __enter__(self):
            return self

        def __exit__(self, exc_type, exc, tb):
            try:
                self._f.close()
            finally:
                return False

        # Allow attribute access for compatibility
        def __getattr__(self, name):
            return getattr(self._f, name)

    def open_patched(file, mode="r", *args, **kwargs):
        f = real_open(file, mode, *args, **kwargs)
        if os.path.basename(file) == os.path.basename(baseline.PAYLOAD_FILE):
            return FileWrapper(f)
        return f

    builtins.open = open_patched
    try:
        yield
    finally:
        builtins.open = real_open


def make_deterministic_queries(count: int, seed: int) -> List[baseline.Query]:
    rng = random.Random(seed)
    now = int(time.time())
    queries: List[baseline.Query] = []
    actions = [None, "UPDATE", "CREATE", "DELETE"]

    for _ in range(count):
        q = baseline.Query(
            from_ts=now - 7 * 24 * 3600,
            to_ts=now,
            actor_id=rng.choice([None, rng.randint(1, 2000)]),
            action=rng.choice(actions),
            page=rng.randint(1, MAX_PAGE),
            page_size=rng.choice(PAGE_SIZES),
        )
        queries.append(q)
    return queries


def semantic_and_disk_checks() -> None:
    print("→ Running semantic equivalence and per-event disk-read checks")
    # Prepare services
    baseline.init()
    enhanced.init()

    # deterministic queries (include explicit boundary cases)
    extra = [
        baseline.Query(from_ts=int(time.time()) - 7 * 24 * 3600, to_ts=int(time.time()), actor_id=None, action=None, page=1, page_size=10),
        baseline.Query(from_ts=int(time.time()) - 7 * 24 * 3600, to_ts=int(time.time()), actor_id=None, action=None, page=MAX_PAGE, page_size=50),
    ]

    queries = make_deterministic_queries(300, seed=123456)
    queries[0:0] = extra

    # For each query, compare baseline_query vs enhanced.query and verify seek/read counts
    for i, q in enumerate(queries):
        # baseline
        b_counter: Dict[str, int] = {}
        with instrument_payload_access(b_counter):
            bas = baseline_query(q)
        # enhanced
        e_counter: Dict[str, int] = {}
        with instrument_payload_access(e_counter):
            enh = enhanced.query(q)

        if bas["count"] != enh["count"]:
            print(f"Mismatch count for query #{i}: baseline={bas['count']} enhanced={enh['count']}")
            print("Query:", q)
            sys.exit(3)

        # Compare event-by-event
        for be, ee in zip(bas["events"], enh["events"]):
            if be["id"] != ee["id"]:
                print(f"ID mismatch for query #{i}")
                sys.exit(4)
            # Compare required fields exactly
            for key in ("created_at", "actor_id", "action", "resource_type", "resource_id"):
                if be[key] != ee[key]:
                    print(f"Field '{key}' mismatch for query #{i}, id={be['id']}")
                    sys.exit(5)
            # Payload bytes (decoded JSON) must match exactly
            if be["payload"] != ee["payload"]:
                print(f"Payload mismatch for query #{i}, id={be['id']}")
                sys.exit(6)

        # Verify disk access: each returned event must have one seek + one read
        ev_count = bas["count"]
        if b_counter.get("seek_calls", 0) != ev_count or b_counter.get("read_calls", 0) != ev_count:
            print(f"Baseline did not perform expected seek/read per event for query #{i}: seeks={b_counter.get('seek_calls',0)} reads={b_counter.get('read_calls',0)} events={ev_count}")
            sys.exit(7)
        if e_counter.get("seek_calls", 0) != ev_count or e_counter.get("read_calls", 0) != ev_count:
            print(f"Enhanced did not perform expected seek/read per event for query #{i}: seeks={e_counter.get('seek_calls',0)} reads={e_counter.get('read_calls',0)} events={ev_count}")
            sys.exit(8)

    print("✅ Semantic equivalence and payload disk-read contract verified for all deterministic queries")


def concurrency_checks() -> None:
    print("→ Running concurrency correctness checks (32 threads)")
    enhanced.init()

    # Prepare a set of deterministic queries and obtain the single-threaded expected results
    queries = make_deterministic_queries(128, seed=9999)
    expected = [enhanced.query(q) for q in queries]

    # Run the same queries concurrently across 32 threads
    def worker(q: baseline.Query) -> Dict[str, Any]:
        return enhanced.query(q)

    with ThreadPoolExecutor(max_workers=CONCURRENCY) as ex:
        futs = [ex.submit(worker, q) for q in queries]
        got = [f.result() for f in as_completed(futs)]

    # Sort results by query tuple so comparison is order-agnostic
    def key_fn(r: Dict[str, Any]) -> Tuple[int, int, int]:
        q = r["query"]
        return (q["page"], q["page_size"], q["from_ts"])  # coarse key

    exp_sorted = sorted(expected, key=key_fn)
    got_sorted = sorted(got, key=key_fn)

    if len(exp_sorted) != len(got_sorted):
        print("Concurrency results count mismatch")
        sys.exit(9)

    for a, b in zip(exp_sorted, got_sorted):
        if a["count"] != b["count"]:
            print("Concurrency result mismatch: counts differ")
            sys.exit(10)

    print("✅ Concurrency correctness verified (no races, deterministic results)")


def make_load_fn(queries: List[baseline.Query], exec_fn):
    """Create a thread-safe load function suitable for runner.run.

    The returned function conforms to runner.run's expected signature: it returns (t0, t1)
    and performs one request from the pre-generated queries list.
    """
    idx = {"i": 0}
    lock = threading.Lock()

    def load_one() -> Tuple[float, float]:
        with lock:
            i = idx["i"]
            idx["i"] += 1
        q = queries[i % len(queries)]
        t0 = time.perf_counter()
        _ = exec_fn(q)
        t1 = time.perf_counter()
        return t0, t1

    return load_one


def benchmark() -> Tuple[Dict[str, Any], Dict[str, Any]]:
    print(f"→ Running benchmark: warmup={WARMUP} total={TOTAL} concurrency={CONCURRENCY} (median of {BENCH_RUNS})")

    def run_for(exec_fn, label: str) -> Dict[str, Any]:
        metrics_list = []
        for run_idx in range(BENCH_RUNS):
            # Generate a deterministic query list for this run so baseline/enhanced runs are comparable
            seed = 1_000_000 + run_idx
            queries = make_deterministic_queries(TOTAL + WARMUP, seed=seed)
            load_fn = make_load_fn(queries, exec_fn)
            metrics, _ = runner.run(load_fn, warmup=WARMUP, total=TOTAL, concurrency=CONCURRENCY)
            metrics_list.append(metrics)
            print(f"  {label} run {run_idx + 1}: rps={metrics['rps']:.2f} p99={metrics['p99_ms']:.2f}ms")
        # compute medians across runs
        med = {}
        for k in ("rps", "p50_ms", "p90_ms", "p95_ms", "p99_ms", "avg_ms"):
            med[k] = statistics.median([m[k] for m in metrics_list])
        med["runs"] = metrics_list
        return med

    baseline_med = run_for(baseline_query, "baseline")
    enhanced_med = run_for(lambda q: enhanced.query(q), "enhanced")

    print("\nBenchmark summary (median of runs):")
    print("Baseline:  RPS={rps:.2f} p99={p99_ms:.2f}ms".format(**baseline_med))
    print("Enhanced:  RPS={rps:.2f} p99={p99_ms:.2f}ms".format(**enhanced_med))

    return baseline_med, enhanced_med


def gating(baseline_med: Dict[str, Any], enhanced_med: Dict[str, Any]) -> None:
    # Gates: enhanced p99 <= 0.80 * baseline p99, and enhanced rps >= 1.20 * baseline rps
    p99_gate = enhanced_med["p99_ms"] <= 0.80 * baseline_med["p99_ms"]
    rps_gate = enhanced_med["rps"] >= 1.20 * baseline_med["rps"]

    print("\nGates:")
    print(f"  p99: enhanced={enhanced_med['p99_ms']:.2f}ms <= 0.80 * baseline={baseline_med['p99_ms']:.2f}ms -> {p99_gate}")
    print(f"  rps: enhanced={enhanced_med['rps']:.2f} >= 1.20 * baseline={baseline_med['rps']:.2f} -> {rps_gate}")

    if not (p99_gate and rps_gate):
        print("\nERROR: Performance gates not satisfied")
        sys.exit(11)
    print("\n✅ Performance gates satisfied")


def main() -> None:
    if sys.version_info < (3, 8):
        print("Python 3.8+ is required")
        sys.exit(1)

    check_baseline_integrity()
    semantic_and_disk_checks()
    concurrency_checks()
    baseline_med, enhanced_med = benchmark()
    gating(baseline_med, enhanced_med)

    # Print raw JSON summary of the successful run for README
    summary = {"baseline_med": baseline_med, "enhanced_med": enhanced_med}
    print("\nRAW_SUMMARY_JSON_START")
    print(json.dumps(summary, indent=2))
    print("RAW_SUMMARY_JSON_END")

    print("\nAll checks passed — congratulations ✅")


if __name__ == "__main__":
    main()
